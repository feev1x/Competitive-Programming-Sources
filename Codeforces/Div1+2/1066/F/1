#include <bits/stdc++.h>

int main() {
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);
    
    int n; std::cin >> n;

    std::vector<int> prev(n + 1, -1), next(n + 1, -1);

    int m = cbrt(n);

    for (int i = 2; i <= n; ++i)
        prev[i] = i - 1;

    for (int i = 1; i < n; ++i)
        next[i] = i + 1;

    auto Del = [&](int i) {
        std::cout << i << ' ' << next[i] - i << '\n';

        prev[next[i]] = prev[i];
        next[prev[i]] = next[i];
    };

    std::cout << n - 1 << '\n';
    while (prev[n] != -1) {

        if (prev[prev[n]] == -1) {
            Del(prev[n]);
            break;
        }

        for (int j = m; j >= 2; --j) {
            int nw = n;

            while (nw != -1) {
                int _ = j;

                while (_-- && nw != -1)
                    nw = prev[nw];

                if (nw != -1)
                    Del(nw);
            }
        }
    }
    return 0;
}
