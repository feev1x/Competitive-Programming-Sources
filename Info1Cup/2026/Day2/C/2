#include <bits/stdc++.h>

constexpr int MOD = 1e9 + 7;

inline void add_self(int &a, int b) {
    a += b;

    if (a >= MOD) {
        a -= MOD;
    }

    if (a < 0) {
        a += MOD;
    }
}

inline int mul(int a, int b) {
    return (int64_t)a * b % MOD;
}

inline int binpow(int a, int n) {
    int res = 1;

    while (n) {
        if (n & 1) {
            res = mul(res, a);
        }

        a = mul(a, a);
        n >>= 1;
    }

    return res;
}

inline int divide(int a, int b) {
    return mul(a, binpow(b, MOD - 2));
}

struct Segtree {
    std::vector<int> t, psh;
    std::stack<std::pair<int, int>> ut, up;
    int n;

    Segtree(int _n) : n(_n) {
        t.resize(4 * n + 1);
        psh.assign(4 * n + 1, 1);
    }

    inline void push(int v) {
        if (psh[v] != 1) {
            ut.emplace(v << 1, t[v << 1]);
            ut.emplace(v << 1 | 1, t[v << 1 | 1]);
            up.emplace(v << 1, psh[v << 1]);
            up.emplace(v << 1 | 1, psh[v << 1 | 1]);
            up.emplace(v, psh[v]);
            t[v << 1] = mul(t[v << 1], psh[v]);
            t[v << 1 | 1] = mul(t[v << 1 | 1], psh[v]);
            psh[v << 1] = mul(psh[v << 1], psh[v]);
            psh[v << 1 | 1] = mul(psh[v << 1 | 1], psh[v]);

            psh[v] = 1;
        }
    }

    inline void update(int v, int tl, int tr, int l, int r, int x) {
        if (l > tr || tl > r) {
            return;
        }

        if (l <= tl && tr <= r) {
            ut.emplace(v, t[v]);
            up.emplace(v, psh[v]);
            t[v] = mul(t[v], x);
            psh[v] = mul(psh[v], x);
            return;
        }

        push(v);

        int tm = tl + tr >> 1;

        update(v << 1, tl, tm, l, r, x);
        update(v << 1 | 1, tm + 1, tr, l, r, x);

        ut.emplace(v, t[v]);

        t[v] = t[v << 1];

        add_self(t[v], t[v << 1 | 1]);
    }

    inline void add(int v, int tl, int tr, int i, int x) {
        if (tl == tr) {
            ut.emplace(v, t[v]);
            up.emplace(v, psh[v]);
            t[v] = x;
            psh[v] = 1;
            return;
        }

        push(v);

        int tm = tl + tr >> 1;

        if (i <= tm) {
            add(v << 1, tl, tm, i, x);
        } else {
            add(v << 1 | 1, tm + 1, tr, i, x);
        }

        ut.emplace(v, t[v]);
        t[v] = t[v << 1];

        add_self(t[v], t[v << 1 | 1]);
    }

    inline int get(int v, int tl, int tr, int l, int r) {
        if (tl > r || l > tr) {
            return 0;
        }

        if (l <= tl && tr <= r) {
            return t[v];
        }

        push(v);
        int tm = tl + tr >> 1;

        int res = get(v << 1, tl, tm, l, r);

        add_self(res, get(v << 1 | 1, tm + 1, tr, l, r));

        return res;
    }

    inline void update(int l, int r, int x) {
        update(1, 1, n, l, r, x);
    }

    inline void add(int i, int x) {
        add(1, 1, n, i, x);
    }

    inline int get(int l, int r) {
        return get(1, 1, n, l, r);
    }

    inline void clr() {
        while (ut.size()) {
            ut.pop();
        }

        while (up.size()) {
            up.pop();
        }
    }

    inline void rollback() {
        while (ut.size()) {
            auto [v, val] = ut.top();

            t[v] = val;
            ut.pop();
        }

        while (up.size()) {
            auto [v, val] = up.top();

            psh[v] = val;
            up.pop();
        }
    }
};

struct Bit {
    std::vector<int> p;
    int n;

    Bit(int _n) : n(_n) {
        p.resize(n + 1);
    }

    inline void update(int r, int x) {
        for (; r <= n; r += r & -r) {
            add_self(p[r], x);
        }
    }

    inline int get(int r) {
        int res = 0;

        for (; r > 0; r -= r & -r) {
            add_self(res, p[r]);
        }

        return res;
    }

    inline int get(int l, int r) {
        int res = get(r);

        add_self(res, -get(l - 1));

        return res;
    }
};

int main() {
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);
    
    int n; std::cin >> n;

    std::vector<int> a(n + 1), b(n + 1), pw(2 * n + 1, 1);
    for (int i = 1; i <= n; ++i) {
        std::cin >> a[i];
    }

    for (int i = 1; i <= 2 * n; ++i) {
        pw[i] = mul(pw[i - 1], 2);
    }

    for (int i = 1; i <= n; ++i) {
        std::cin >> b[i];

        if (b[i] < a[i]) {
            std::swap(a[i], b[i]);
        }
    }

    int q; std::cin >> q;
    std::vector<int> ans(q);
    std::vector<std::vector<std::tuple<int, int, int>>> qq(n + 1);
    for (int i = 0; i < q; ++i) {
        int l, r; std::cin >> l >> r;

        qq[l].emplace_back(r, l, i);
    }

    std::set<std::pair<int, int>> st;

    Segtree t(n);
    for (int l = n; l >= 1; --l) {
        st.emplace(a[l], l);

        t.update(l, n, 2);
        t.add(l, pw[n - l + 1]);

        while (st.size() && st.begin()->first < a[l]) {
            t.add(st.begin()->second, 0);
            st.erase(st.begin());
        }

        for (auto [r, L, i]: qq[l]) {
            ans[i] = divide(t.get(l, r), pw[n - r]);
        }
    }

    for (auto u: ans) {
        std::cout << u << '\n';
    }
}
