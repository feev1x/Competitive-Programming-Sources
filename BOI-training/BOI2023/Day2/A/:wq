#include <bits/stdc++.h>

struct custom_hash {
   static uint64_t splitmix64(uint64_t x) {
       x += 0x9e3779b97f4a7c15;
       x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9;
       x = (x ^ (x >> 27)) * 0x94d049bb133111eb;
       return x ^ (x >> 31);
   }

   size_t operator()(uint64_t x) const {
       static const uint64_t FIXED_RANDOM = std::chrono::steady_clock::now().time_since_epoch().count();
       return splitmix64(x + FIXED_RANDOM);
   }
};

constexpr int MOD = 1e9 + 7;

inline int mul(int a, int b) {
    return (int64_t)a * b % MOD;
}

inline void add_self(int &a, int b) {
    a += b;

    if (a >= MOD)
        a -= MOD;

    if (a < 0)
        a += MOD;
}

int main() {
    std::ios_base::sync_with_stdio(false);
    std::cin.tie(nullptr);
    
    int n, q; std::cin >> n >> q;

    std::vector<std::vector<int>> g(n);
    std::vector<int64_t> a(n), f(n), p(n), tin(n), tout(n);
    for (int i = 1; i < n; ++i) {
        std::cin >> p[i];

        g[p[i]].emplace_back(i);
    }

    for (auto &u: a)
        std::cin >> u;

    f[0] = a[0];

    int sum = a[0] % MOD, sum1 = mul(int(a[0] % MOD), int(a[0] % MOD));
    for (int i = 1; i < n; ++i) {
        f[i] = f[p[i]] & a[i], add_self(sum, int(f[i] % MOD)), add_self(sum1, mul(int(f[i] % MOD), int(f[i] % MOD)) % MOD);
    }

    int _t = 0;
    auto Dfs = [&](auto &&self, int v) -> void {
        tin[v] = ++_t;

        for (auto to: g[v])
            self(self, to);

        tout[v] = ++_t;
    };

    Dfs(Dfs, 0);

    std::cout << mul(sum, sum) << ' ' << mul(((mul(sum, sum) - sum1) % MOD + MOD) % MOD, (MOD + 1) / 2) << '\n';
    while (q--) {
        int64_t v, x; std::cin >> v >> x;

        for (int i = 0; i < n; ++i)
            if (tin[v] <= tin[i] && tout[i] <= tout[v]) {
                add_self(sum, (int)(-f[i] % MOD));
                add_self(sum1, -mul(int(f[i] % MOD), int(f[i] % MOD)));
                f[i] = f[i] & x;
                add_self(sum, int(f[i] % MOD));
                add_self(sum1, mul(int(f[i] % MOD), int(f[i] % MOD)));
            }

        std::cout << mul(sum, sum) << ' ' << mul(((mul(sum, sum) - sum1) % MOD + MOD) % MOD, (MOD + 1) / 2) << '\n';
    }
    return 0;
}
